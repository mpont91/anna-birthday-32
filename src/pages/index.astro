---
import Layout from '../layouts/Layout.astro'
import Scene from '../components/Scene.astro'
---

<Layout title="Happy 32nd, Anna">
  <Scene
    title="Happy 32nd, Anna 🎉"
    text="Swipe down..."
    bgClass="bg-pink-50"
    textClass="text-slate-800"
  />

  <Scene
    title="Keep going..."
    text="You thought this was going to be short?"
    bgClass="bg-rose-900"
    textClass="text-white"
  />

  <Scene
    title="A bit more..."
    text="Just warming up those fingers."
    bgClass="bg-pink-50"
    textClass="text-slate-800"
  />

  <Scene
    title="Almost there..."
    text="Or maybe not."
    bgClass="bg-rose-900"
    textClass="text-white"
  />
</Layout>
